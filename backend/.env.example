# AI Interview Agent — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ── Application ──────────────────────────────────────────────────────
APP_NAME=AI Interview Agent
APP_VERSION=0.1.0
DEBUG=false

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (JSON array of allowed origins) ─────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Data file paths (absolute or relative to backend/) ───────────────
# Defaults point to app/data/files/ — override for custom locations.
# CANDIDATES_FILE=app/data/files/candidates.json
# CURRICULUM_FILE=app/data/files/curriculum.json

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AI Engine (not implemented yet) ─────────────────────────────────
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
